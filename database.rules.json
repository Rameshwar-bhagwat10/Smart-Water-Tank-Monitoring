{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['email', 'assignedTankId'])"
      }
    },
    "tanks": {
      "$tankId": {
        "live": {
          ".read": "auth != null",
          ".write": true
        },
        "commands": {
          ".read": true,
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['requestedMode', 'requestedPumpState', 'commandId', 'requestedAt', 'requestedBy'])",
          "requestedMode": {
            ".validate": "newData.isString() && (newData.val() === 'AUTO' || newData.val() === 'MANUAL')"
          },
          "requestedPumpState": {
            ".validate": "newData.isString() && (newData.val() === 'ON' || newData.val() === 'OFF')"
          },
          "commandId": {
            ".validate": "newData.isString() && newData.val().length > 0"
          },
          "requestedAt": {
            ".validate": "newData.isNumber()"
          },
          "requestedBy": {
            ".validate": "newData.isString() && newData.val() === auth.uid"
          }
        },
        "commandAcks": {
          ".read": "auth != null",
          "$commandId": {
            ".write": true
          }
        },
        "alerts": {
          ".read": "auth != null",
          "$alertId": {
            ".write": true
          }
        }
      }
    }
  }
}