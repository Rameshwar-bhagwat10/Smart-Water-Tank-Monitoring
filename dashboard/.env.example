# Firebase Client Configuration (Vite Web App)
# Note: Firebase Web config identifies project resources and is not a private credential.
# Access control and data protection are strictly enforced via Firebase Security Rules and Auth.
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
